    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "fast-xml-parser": "^5.7.3",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prisma": "^5",
    "puppeteer-core": "^24.43.0",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vitest": "^4.1.5"
