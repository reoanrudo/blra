    "lawbook:scope": "npx tsx scripts/enforce-law-book-scope.ts",
    "lawbook:ranges": "npx tsx scripts/seed-law-book-ranges.ts",
    "lawbook:supplements": "npx tsx scripts/backfill-supplementary-provisions.ts",
    "lawbook:verify": "npx tsx scripts/verify-law-book.ts",
