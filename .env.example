# PostgreSQL 接続文字列（Docker Compose 構成）
DATABASE_URL=postgres://blra:blra_dev@localhost:5433/blra

# Fastify サーバー
PORT=3000
HOST=0.0.0.0

# ログレベル（trace | debug | info | warn | error | fatal）
LOG_LEVEL=info

# e-Gov 法令API v2（認証不要・デフォルト値で動作）
# EGOV_API_BASE=https://laws.e-gov.go.jp/api/2

# 原本XML保存先（デフォルト: data/raw）
# RAW_DATA_DIR=data/raw

# === M5: OIDC / Keycloak 認証 ===
# OIDC を有効にするか（true で有効・未設定 or false でスタブモード）
# スタブモードでは認証未使用（M4 までのテスト互換）
# OIDC_ENABLED=true

# Keycloak 管理者パスワード（docker-compose.yml が参照）
# §14.2「Secret 管理（環境変数への平文埋め込み禁止）」
# 生成例: openssl rand -base64 24
# KEYCLOAK_ADMIN_PASSWORD=changeme

# Keycloak の issuer URL
# OIDC_ISSUER=http://localhost:8080/realms/blra

# OIDC クライアントID・シークレット（Keycloak で作成）
# OIDC_CLIENT_ID=blra-app
# OIDC_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# コールバックURL（Fastify 側）
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# ログアウト後リダイレクト先
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# @fastify/secure-session の Cookie 暗号化キー（32バイト以上）
# 生成例: openssl rand -base64 32
# SESSION_SECRET=your-secret-key-here

# Cookie 有効期限（秒・デフォルト28800 = 8時間）
# SESSION_MAX_AGE=28800
